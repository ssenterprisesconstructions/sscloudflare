/static/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=3600

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self' https: data:; script-src 'self' 'unsafe-inline' https://maxcdn.bootstrapcdn.com https://oss.maxcdn.com https://fonts.googleapis.com https://cdnjs.cloudflare.com https://www.google.com https://static.cloudflareinsights.com; script-src-elem 'self' https://cdnjs.cloudflare.com https://www.google.com https://static.cloudflareinsights.com https://maxcdn.bootstrapcdn.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://maxcdn.bootstrapcdn.com https://cdnjs.cloudflare.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com https://maxcdn.bootstrapcdn.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://static.cloudflareinsights.com; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'self'
